{
  "name": "tech-news-app",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first dashboard for tech news, learning roadmaps and tech culture",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "ingest": "npm run ingest -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": { "node": ">=22.13" }
}
